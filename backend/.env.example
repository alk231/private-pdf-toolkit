# PDF Toolkit backend. There are NO secrets: the server needs no keys or tokens.
# Copy to .env only if you want to change a default. Every value below is the default.

# Server (Render sets PORT automatically)
PORT=10000
WORK_DIR=/tmp/pdf-toolkit

# Limits
MAX_FILE_MB=25
MAX_JOB_MB=60
MAX_CONCURRENT_JOBS=1
JOB_TTL_MIN=45
JOB_TIMEOUT_SEC=120
RATE_LIMIT_PER_HOUR=30
OCR_MAX_PAGES=30

# Extra safety knobs
MAX_QUEUE=20
MAX_TOTAL_JOBS=40
WORKER_MEMORY_MB=1024
WORKER_MAX_OUTPUT_MB=300
FAST_WAIT_SEC=20
MIN_FREE_DISK_MB=200
JANITOR_INTERVAL_SEC=30
TRUST_PROXY=true
LOG_LEVEL=INFO

# Local testing only. Keep both OFF in production.
ENABLE_SELFTEST_TOOLS=0
ENABLE_DOCS=0
